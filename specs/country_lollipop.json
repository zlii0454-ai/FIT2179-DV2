{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 700,
  "height": 390,

  "title": {
    "text": "Top Source Countries of International Students",
    "subtitle": "Total students are calculated as continuing students plus new students",
    "anchor": "start",
    "fontSize": 17,
    "subtitleFontSize": 12,
    "fontWeight": "bold",
    "subtitleColor": "#555"
  },

  "data": {
    "url": "Data/dv2_cleaned_data/students_by_country.csv"
  },

  "transform": [
    {
      "calculate": "toNumber(datum.Students)",
      "as": "Students_num"
    },
    {
      "calculate": "toNumber(datum.Continuing)",
      "as": "Continuing_num"
    },
    {
      "calculate": "toNumber(datum.New)",
      "as": "New_num"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "Rank"
        }
      ],
      "sort": [
        {
          "field": "Students_num",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "datum.Rank <= 15"
    },
    {
      "calculate": "0",
      "as": "Zero"
    }
  ],

  "encoding": {
    "y": {
      "field": "Country",
      "type": "nominal",
      "sort": {
        "field": "Students_num",
        "order": "descending"
      },
      "title": null
    }
  },

  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2,
        "color": "#b8c4d0"
      },
      "encoding": {
        "x": {
          "field": "Zero",
          "type": "quantitative",
          "title": "Number of Students",
          "axis": {
            "format": ",.0f"
          }
        },
        "x2": {
          "field": "Students_num"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 120,
        "color": "#1f4e79"
      },
      "encoding": {
        "x": {
          "field": "Students_num",
          "type": "quantitative",
          "title": "Number of Students",
          "axis": {
            "format": ",.0f"
          }
        },
        "tooltip": [
          {
            "field": "Country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "Students_num",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Total Students"
          },
          {
            "field": "Continuing_num",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Continuing Students"
          },
          {
            "field": "New_num",
            "type": "quantitative",
            "format": ",.0f",
            "title": "New Students"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 10,
        "color": "#333333"
      },
      "encoding": {
        "x": {
          "field": "Students_num",
          "type": "quantitative"
        },
        "text": {
          "field": "Students_num",
          "type": "quantitative",
          "format": ",.0f"
        }
      }
    }
  ],

  "config": {
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "grid": true,
      "gridColor": "#eeeeee"
    },
    "view": {
      "stroke": "transparent"
    }
  }
}

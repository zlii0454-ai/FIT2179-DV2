{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Top 5 Source Countries within Each State and Territory",
    "subtitle": "Bars show each country’s share of that state or territory’s international students",
    "anchor": "start",
    "fontSize": 17,
    "subtitleFontSize": 12,
    "fontWeight": "bold",
    "subtitleColor": "#555"
  },

  "data": {
    "url": "Data/dv2_cleaned_data/state_country.csv"
  },

  "transform": [
    {
      "calculate": "toNumber(datum.Students)",
      "as": "Students_num"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "Students_num",
          "as": "State_Total"
        }
      ],
      "groupby": ["StateCode"]
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "Rank"
        }
      ],
      "groupby": ["StateCode"],
      "sort": [
        {
          "field": "Students_num",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "datum.Rank <= 5"
    },
    {
      "calculate": "datum.Students_num / datum.State_Total",
      "as": "Share"
    }
  ],

  "facet": {
    "field": "StateCode",
    "type": "nominal",
    "title": null,
    "sort": ["NSW", "VIC", "QLD", "WA", "SA", "TAS", "ACT", "NT"],
    "header": {
      "labelFontSize": 13,
      "labelFontWeight": "bold",
      "labelColor": "#1f4e79"
    }
  },

  "columns": 4,

  "spec": {
    "width": 190,
    "height": 145,

    "layer": [
      {
        "mark": {
          "type": "bar",
          "cornerRadiusEnd": 3,
          "color": "#1f4e79"
        },
        "encoding": {
          "y": {
            "field": "Country",
            "type": "nominal",
            "title": null,
            "sort": {
              "field": "Rank",
              "order": "ascending"
            },
            "axis": {
              "labelFontSize": 9
            }
          },
          "x": {
            "field": "Share",
            "type": "quantitative",
            "title": null,
            "axis": {
              "format": ".0%",
              "labelFontSize": 8,
              "grid": true
            }
          },
          "tooltip": [
            {
              "field": "State",
              "type": "nominal",
              "title": "State / Territory"
            },
            {
              "field": "Country",
              "type": "nominal",
              "title": "Source Country"
            },
            {
              "field": "Rank",
              "type": "quantitative",
              "format": ".0f",
              "title": "Rank"
            },
            {
              "field": "Students_num",
              "type": "quantitative",
              "format": ",.0f",
              "title": "Students"
            },
            {
              "field": "Share",
              "type": "quantitative",
              "format": ".1%",
              "title": "Share within State"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "text",
          "align": "left",
          "dx": 4,
          "fontSize": 8,
          "color": "#333333"
        },
        "encoding": {
          "y": {
            "field": "Country",
            "type": "nominal",
            "sort": {
              "field": "Rank",
              "order": "ascending"
            }
          },
          "x": {
            "field": "Share",
            "type": "quantitative"
          },
          "text": {
            "field": "Share",
            "type": "quantitative",
            "format": ".0%"
          }
        }
      }
    ]
  },

  "resolve": {
    "scale": {
      "y": "independent"
    }
  },

  "config": {
    "axis": {
      "titleFontSize": 10,
      "labelFontSize": 9,
      "gridColor": "#eeeeee"
    },
    "view": {
      "stroke": "transparent"
    }
  }
}

{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Top 5 Source Countries within Each State and Territory",
    "subtitle": "Small multiples reveal local differences in international student communities",
    "anchor": "start",
    "fontSize": 17,
    "subtitleFontSize": 12,
    "fontWeight": "bold",
    "subtitleColor": "#555"
  },

  "data": {
    "url": "Data/dv2_cleaned_data/state_country.csv"
  },

  "transform": [
    {
      "calculate": "toNumber(datum.Students)",
      "as": "Students_num"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "Rank"
        }
      ],
      "groupby": ["StateCode"],
      "sort": [
        {
          "field": "Students_num",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "datum.Rank <= 5"
    }
  ],

  "facet": {
    "column": {
      "field": "StateCode",
      "type": "nominal",
      "title": null,
      "sort": ["NSW", "VIC", "QLD", "WA", "SA", "TAS", "ACT", "NT"],
      "header": {
        "labelFontSize": 13,
        "labelFontWeight": "bold"
      }
    }
  },

  "spec": {
    "width": 115,
    "height": 180,

    "mark": {
      "type": "bar",
      "cornerRadiusEnd": 3,
      "color": "#1f4e79"
    },

    "encoding": {
      "y": {
        "field": "Country",
        "type": "nominal",
        "title": null,
        "sort": {
          "field": "Rank",
          "order": "ascending"
        },
        "axis": {
          "labelFontSize": 9
        }
      },

      "x": {
        "field": "Students_num",
        "type": "quantitative",
        "title": null,
        "axis": {
          "format": ",.0f",
          "labelFontSize": 8,
          "labelAngle": -35,
          "grid": true
        }
      },

      "tooltip": [
        {
          "field": "State",
          "type": "nominal",
          "title": "State / Territory"
        },
        {
          "field": "Country",
          "type": "nominal",
          "title": "Source Country"
        },
        {
          "field": "Rank",
          "type": "quantitative",
          "format": ".0f",
          "title": "Rank"
        },
        {
          "field": "Students_num",
          "type": "quantitative",
          "format": ",.0f",
          "title": "Students"
        }
      ]
    }
  },

  "resolve": {
    "scale": {
      "y": "independent"
    }
  },

  "config": {
    "axis": {
      "titleFontSize": 10,
      "labelFontSize": 9,
      "gridColor": "#eeeeee"
    },
    "view": {
      "stroke": "transparent"
    }
  }
}

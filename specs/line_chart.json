{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 350,
  "data": {
    "url": "Data/dv2_cleaned_data/student_trend.csv"
  },
  "mark": {
    "type": "line",
    "point": true
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal"
    },
    "y": {
      "field": "Enrolments",
      "type": "quantitative"
    }
  }
}

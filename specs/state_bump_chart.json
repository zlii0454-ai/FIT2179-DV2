{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 540,
  "height": 320,

  "title": {
    "text": "Ranking Flow of Major Source Countries Across States",
    "subtitle": "Rank 1 means the largest source-country group within that state or territory",
    "anchor": "start",
    "fontSize": 17,
    "subtitleFontSize": 12,
    "fontWeight": "bold",
    "subtitleColor": "#555"
  },

  "data": {
    "url": "Data/dv2_cleaned_data/state_country.csv"
  },

  "transform": [
    {
      "calculate": "toNumber(datum.Students)",
      "as": "Students_num"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "Rank"
        }
      ],
      "groupby": ["StateCode"],
      "sort": [
        {
          "field": "Students_num",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "indexof(['China','India','Nepal','Vietnam','Bangladesh'], datum.Country) >= 0"
    },
    {
      "filter": "datum.Rank <= 6"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "line",
        "point": true,
        "strokeWidth": 3,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "StateCode",
          "type": "ordinal",
          "title": "State / Territory",
          "sort": ["NSW", "VIC", "QLD", "WA", "SA", "TAS", "ACT", "NT"],
          "axis": {
            "labelAngle": 0
          }
        },

        "y": {
          "field": "Rank",
          "type": "quantitative",
          "title": "Rank within State",
          "scale": {
            "domain": [1, 6],
            "reverse": true
          },
          "axis": {
            "tickMinStep": 1,
            "values": [1, 2, 3, 4, 5, 6]
          }
        },

        "color": {
          "field": "Country",
          "type": "nominal",
          "title": "Source Country",
          "scale": {
            "domain": ["China", "India", "Nepal", "Vietnam", "Bangladesh"],
            "range": ["#1f4e79", "#f28e2b", "#59a14f", "#e15759", "#b07aa1"]
          }
        },

        "tooltip": [
          {
            "field": "State",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "Country",
            "type": "nominal",
            "title": "Source Country"
          },
          {
            "field": "Rank",
            "type": "quantitative",
            "format": ".0f",
            "title": "Rank"
          },
          {
            "field": "Students_num",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Students"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "StateCode",
          "type": "ordinal",
          "sort": ["NSW", "VIC", "QLD", "WA", "SA", "TAS", "ACT", "NT"]
        },
        "y": {
          "field": "Rank",
          "type": "quantitative",
          "scale": {
            "domain": [1, 6],
            "reverse": true
          }
        },
        "text": {
          "field": "Country"
        },
        "color": {
          "field": "Country",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": ["China", "India", "Nepal", "Vietnam", "Bangladesh"],
            "range": ["#1f4e79", "#f28e2b", "#59a14f", "#e15759", "#b07aa1"]
          }
        },
        "opacity": {
          "condition": {
            "test": "datum.StateCode == 'NT'",
            "value": 1
          },
          "value": 0
        }
      }
    }
  ],

  "config": {
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "grid": true,
      "gridColor": "#eeeeee"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "orient": "right"
    },
    "view": {
      "stroke": "transparent"
    }
  }
}

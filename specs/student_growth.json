{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 820,
  "height": 380,

  "title": {
    "text": "International Student Growth in Australia (2002–2020)",
    "subtitle": "Enrolments peaked in 2019 before declining in 2020",
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 13,
    "fontWeight": "bold",
    "subtitleColor": "#555"
  },

  "data": {
    "url": "Data/dv2_cleaned_data/student_trend.csv"
  },

  "transform": [
    {
      "fold": ["Enrolments", "Commencements"],
      "as": ["Type", "Students"]
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "line",
        "point": true,
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": "Year",
          "axis": {
            "labelAngle": -45
          }
        },
        "y": {
          "field": "Students",
          "type": "quantitative",
          "title": "Number of Students",
          "axis": {
            "format": ",.0f"
          }
        },
        "color": {
          "field": "Type",
          "type": "nominal",
          "title": "Student Measure",
          "scale": {
            "domain": ["Enrolments", "Commencements"],
            "range": ["#1f4e79", "#f28e2b"]
          }
        },
        "tooltip": [
          {
            "field": "Year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "Type",
            "type": "nominal",
            "title": "Measure"
          },
          {
            "field": "Students",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Students"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Year == 2019 && datum.Type == 'Enrolments'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "dy": -12,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#1f4e79"
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal"
        },
        "y": {
          "field": "Students",
          "type": "quantitative"
        },
        "text": {
          "value": "Peak in 2019"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Year == 2020 && datum.Type == 'Enrolments'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "dy": 16,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#333333"
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal"
        },
        "y": {
          "field": "Students",
          "type": "quantitative"
        },
        "text": {
          "value": "Decline in 2020"
        }
      }
    }
  ],

  "config": {
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "grid": true,
      "gridColor": "#e6e6e6"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "orient": "right"
    },
    "view": {
      "stroke": "transparent"
    }
  }
}

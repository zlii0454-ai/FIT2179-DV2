{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 760,
  "height": 360,

  "title": {
    "text": "International Students per 1,000 Residents",
    "subtitle": "A custom metric showing international student concentration by state and territory",
    "anchor": "start",
    "fontSize": 17,
    "subtitleFontSize": 12,
    "fontWeight": "bold",
    "subtitleColor": "#555"
  },

  "data": {
    "url": "Data/dv2_cleaned_data/state_student_metrics.csv"
  },

  "transform": [
    {
      "calculate": "toNumber(datum.Students)",
      "as": "Students_num"
    },
    {
      "calculate": "toNumber(datum.Population)",
      "as": "Population_num"
    },
    {
      "calculate": "datum.Students_num / datum.Population_num * 1000",
      "as": "Students_per_1000"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2,
        "color": "#c7d4df"
      },
      "encoding": {
        "y": {
          "field": "State",
          "type": "nominal",
          "sort": {
            "field": "Students_per_1000",
            "order": "descending"
          },
          "title": null
        },
        "x": {
          "value": 0
        },
        "x2": {
          "field": "Students_per_1000"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 150,
        "color": "#1f4e79",
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "Students_per_1000",
          "type": "quantitative",
          "title": "International Students per 1,000 Residents",
          "axis": {
            "format": ".1f"
          }
        },
        "y": {
          "field": "State",
          "type": "nominal",
          "sort": {
            "field": "Students_per_1000",
            "order": "descending"
          },
          "title": null
        },
        "tooltip": [
          {
            "field": "State",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "Students_num",
            "type": "quantitative",
            "format": ",.0f",
            "title": "International Students"
          },
          {
            "field": "Population_num",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Population"
          },
          {
            "field": "Students_per_1000",
            "type": "quantitative",
            "format": ".2f",
            "title": "Students per 1,000 Residents"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#333333"
      },
      "encoding": {
        "x": {
          "field": "Students_per_1000",
          "type": "quantitative"
        },
        "y": {
          "field": "State",
          "type": "nominal",
          "sort": {
            "field": "Students_per_1000",
            "order": "descending"
          }
        },
        "text": {
          "field": "Students_per_1000",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ],

  "config": {
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "grid": true,
      "gridColor": "#eeeeee"
    },
    "view": {
      "stroke": "transparent"
    }
  }
}

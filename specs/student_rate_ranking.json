{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 520,
  "height": 260,

  "title": {
    "text": "International Students per 1,000 Residents",
    "subtitle": "A custom metric showing student concentration by state and territory",
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 11,
    "fontWeight": "bold",
    "subtitleColor": "#555"
  },

  "data": {
    "url": "Data/dv2_cleaned_data/state_student_metrics.csv"
  },

  "transform": [
    {
      "calculate": "toNumber(datum.Students)",
      "as": "Students_num"
    },
    {
      "calculate": "toNumber(datum.Population)",
      "as": "Population_num"
    },
    {
      "calculate": "datum.Students_num / datum.Population_num * 1000",
      "as": "Students_per_1000"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "Rank"
        }
      ],
      "sort": [
        {
          "field": "Students_per_1000",
          "order": "descending"
        }
      ]
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": 3,
        "color": "#c7d4df"
      },
      "encoding": {
        "x": {
          "field": "Students_per_1000",
          "type": "quantitative",
          "title": "Students per 1,000 residents",
          "scale": {
            "domain": [0, 30]
          },
          "axis": {
            "format": ".1f"
          }
        },
        "y": {
          "field": "StateCode",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "Rank",
            "order": "ascending"
          }
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 120,
        "color": "#1f4e79",
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "Students_per_1000",
          "type": "quantitative"
        },
        "y": {
          "field": "StateCode",
          "type": "nominal",
          "sort": {
            "field": "Rank",
            "order": "ascending"
          }
        },
        "tooltip": [
          {
            "field": "State",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "Students_num",
            "type": "quantitative",
            "format": ",.0f",
            "title": "International Students"
          },
          {
            "field": "Population_num",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Population"
          },
          {
            "field": "Students_per_1000",
            "type": "quantitative",
            "format": ".2f",
            "title": "Students per 1,000 Residents"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#333333"
      },
      "encoding": {
        "x": {
          "field": "Students_per_1000",
          "type": "quantitative"
        },
        "y": {
          "field": "StateCode",
          "type": "nominal",
          "sort": {
            "field": "Rank",
            "order": "ascending"
          }
        },
        "text": {
          "field": "Students_per_1000",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ],

  "config": {
    "axis": {
      "labelFontSize": 10,
      "titleFontSize": 10,
      "grid": true,
      "gridColor": "#eeeeee"
    },
    "view": {
      "stroke": "transparent"
    }
  }
}

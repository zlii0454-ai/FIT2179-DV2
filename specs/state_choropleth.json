{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 760,
  "height": 480,

  "title": {
    "text": "International Students per 1,000 Residents",
    "subtitle": "Darker states have a higher international student concentration relative to population",
    "anchor": "start",
    "fontSize": 17,
    "subtitleFontSize": 12,
    "fontWeight": "bold",
    "subtitleColor": "#555"
  },

  "data": {
    "url": "Data/dv2_cleaned_data/australian-states-d3.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },

  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "Data/dv2_cleaned_data/state_student_metrics.csv"
        },
        "key": "State",
        "fields": [
          "StateCode",
          "Students",
          "Population",
          "Countries"
        ]
      }
    },
    {
      "calculate": "toNumber(datum.Students)",
      "as": "Students_num"
    },
    {
      "calculate": "toNumber(datum.Population)",
      "as": "Population_num"
    },
    {
      "calculate": "toNumber(datum.Countries)",
      "as": "Countries_num"
    },
    {
      "calculate": "datum.Students_num / datum.Population_num * 1000",
      "as": "Students_per_1000"
    }
  ],

  "projection": {
    "type": "mercator"
  },

  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 1.2
  },

  "encoding": {
    "color": {
      "field": "Students_per_1000",
      "type": "quantitative",
      "title": "Students per 1,000 residents",
      "scale": {
        "scheme": "tealblues"
      },
      "legend": {
        "format": ".1f"
      }
    },

    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "type": "nominal",
        "title": "State / Territory"
      },
      {
        "field": "Students_num",
        "type": "quantitative",
        "format": ",.0f",
        "title": "International Students"
      },
      {
        "field": "Population_num",
        "type": "quantitative",
        "format": ",.0f",
        "title": "Population"
      },
      {
        "field": "Students_per_1000",
        "type": "quantitative",
        "format": ".2f",
        "title": "Students per 1,000 Residents"
      },
      {
        "field": "Countries_num",
        "type": "quantitative",
        "format": ",.0f",
        "title": "Source Countries"
      }
    ]
  },

  "config": {
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "orient": "right"
    },
    "view": {
      "stroke": "transparent"
    }
  }
}
